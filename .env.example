# MailForge configuration. Copy to .env and adjust:   cp .env.example .env
# NEVER commit .env. Values below are safe DEVELOPMENT defaults; docker-compose.prod.yml makes the
# secrets mandatory.

# --- Application ------------------------------------------------------------------------------
APP_NAME=Private Mail Testing
NODE_ENV=development            # development | test | production
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
APP_PORT=3000                   # backend port when running it outside Docker

# --- Database (docker compose builds DATABASE_URL from these) ----------------------------------
POSTGRES_USER=mailforge
POSTGRES_PASSWORD=mailforge-dev-password
POSTGRES_DB=mailforge
# Used when running the backend outside Docker (npm run dev:backend):
DATABASE_URL=postgresql://mailforge:mailforge-dev-password@localhost:5432/mailforge
# Docker-free local development with an embedded PostgreSQL (WASM) instead:
# DATABASE_URL=pglite://./data/pg

# --- SMTP capture (Mailpit) ---------------------------------------------------------------------
# Where your application under test sends mail (inside Docker: mailpit:1025; from the host: localhost:1025).
SMTP_HOST=mailpit
SMTP_PORT=1025
# Backend -> Mailpit HTTP API (must NOT be exposed outside the Docker network).
MAILPIT_API_URL=http://mailpit:8025
INGEST_POLL_INTERVAL_MS=1000

# Domain(s) that mailboxes are created under; comma separated. ".local" is NOT publicly routable:
# fine for local development, but real inbound delivery needs a real domain + MX record (docs/DEPLOYMENT.md).
MAIL_DOMAIN=mailtest.local
# Mailpit rejects every recipient that does not match this regex (open-relay protection). KEEP IN SYNC
# with MAIL_DOMAIN. Single-quote it: it contains a "$" that .env parsers would otherwise expand.
SMTP_ALLOWED_RECIPIENTS_REGEX='^[^@\s]+@(mailtest\.local)$'
SMTP_MAX_RECIPIENTS=50

# --- Mailbox lifecycle --------------------------------------------------------------------------
DEFAULT_MAILBOX_TTL_MINUTES=60
MAX_MAILBOX_TTL_MINUTES=1440
MAX_ACTIVE_MAILBOXES=1000
CLEANUP_INTERVAL_SECONDS=60
# Retention: expired mailboxes are purged MAILBOX_RETENTION_HOURS after they expire (0 = immediately);
# messages MESSAGE_RETENTION_HOURS after receipt; attachment files ATTACHMENT_RETENTION_HOURS after receipt.
MESSAGE_RETENTION_HOURS=24
ATTACHMENT_RETENTION_HOURS=24
MAILBOX_RETENTION_HOURS=24

# --- Limits -------------------------------------------------------------------------------------
MAX_EMAIL_SIZE_MB=20
MAX_ATTACHMENT_SIZE_MB=10
MAX_WAIT_TIMEOUT_MS=120000      # upper bound for the wait-for-email test API
# Attachment files are stored here (a volume in Docker: /data/attachments). Never inside the app directory.
# ATTACHMENT_DIR=./data/attachments
# Override the SQL migrations directory (defaults to ./database/migrations).
# MIGRATIONS_DIR=

# --- Verification code detection (optional) ----------------------------------------------------
# Extra keywords that introduce a code, comma separated: VERIFICATION_CODE_KEYWORDS=magic number,login token
VERIFICATION_CODE_KEYWORDS=
# Extra regexes, JSON array; capture group 1 (or the whole match) is the code:
# VERIFICATION_CODE_PATTERNS=["token=([A-Z0-9]{8})"]
VERIFICATION_CODE_PATTERNS=

# --- Authentication -----------------------------------------------------------------------------
API_AUTH_ENABLED=true           # false is allowed in development only; refused when NODE_ENV=production
ADMIN_EMAIL=admin@mailtest.local
ADMIN_PASSWORD=dev-admin-password-123   # creates the first admin on first start. Production: 12+ chars, not a default.
SESSION_TTL_HOURS=12
COOKIE_SECURE=false             # defaults to true when NODE_ENV=production. Set false only for plain-HTTP LAN use.
TRUST_PROXY=1                   # reverse-proxy hops in front of the backend (dev compose: 1, prod overlay: 2)
ALLOWED_ORIGINS=                # extra allowed browser Origins for state-changing requests, comma separated

# --- Rate limits (<count>/<window>, window = Ns | Nm | Nh | hour | Nd) ---------------------------
LOGIN_RATE_LIMIT=10/15m
API_RATE_LIMIT=1000/hour
MAILBOX_CREATION_RATE_LIMIT=100/hour
SEARCH_RATE_LIMIT=600/hour
DOWNLOAD_RATE_LIMIT=600/hour

# --- Published ports (all bound to 127.0.0.1) ---------------------------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=3000
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# --- Production overlay only (docker-compose.prod.yml) -------------------------------------------
# PUBLIC_HOSTNAME=mail-test.example.com    # DNS name Caddy serves and gets a certificate for
# SMTP_BIND_ADDRESS=127.0.0.1              # 0.0.0.0 = accept mail from the internet (needs MX record + firewall)
# MAILPIT_SMTP_PORT=25                     # standard SMTP port for public MX delivery
# Real Gmail/Office inbound mail: see docs/RECEIVING-EXTERNAL-EMAIL.md
