{
  "name": "mailforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private self-hosted disposable email testing platform",
  "workspaces": [
    "backend",
    "frontend",
    "tests"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspace backend && npm run test --workspace frontend",
    "test:e2e": "npm run test --workspace tests",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "seed": "npm run seed --workspace backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.0"
  }
}
